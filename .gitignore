# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Local config & secrets — never commit real endpoints/keys
/rpc-monitor/config.yaml
/rpc-monitor/config.*.yaml
!/rpc-monitor/config.example.yaml
.env
.env.*
!.env.example

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

rpc-monitor/deploy/ansible/inventory/*.yml
rpc-monitor/deploy/ansible/known_hosts

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
