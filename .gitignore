# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Local config & secrets — never commit real endpoints/keys
/config.yaml
/config.*.yaml
!/config.example.yaml
.env
.env.*
!.env.example

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

deploy/ansible/inventory/*.yml
deploy/ansible/known_hosts

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
