# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Local config & secrets — never commit real endpoints/keys
/config.yaml
/config.*.yaml
!/config.example.yaml
.env
.env.*
!.env.example

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Bare-metal inventories hold box IPs; materialized from Doppler at deploy time
deploy/ansible/inventory/*.yml
!deploy/ansible/inventory/example.yml.tmpl
deploy/ansible/known_hosts

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
