# Bare-metal inventories are NOT committed: box IPs (SSH targets) live in
# Doppler and are materialized by deploy.sh at run time from
# INVENTORY_LATITUDE_B64 / INVENTORY_TSW_B64 (base64 of a file shaped like
# this). One file per provider group, named <group>.yml.
latitude:
  vars:
    monitor_infra: latitude
    ansible_user: ubuntu
  hosts:
    rpc-monitor-fra-2:
      ansible_host: 203.0.113.10
      monitor_region: fra
    rpc-monitor-tyo-2:
      ansible_host: 203.0.113.11
      monitor_region: tyo
