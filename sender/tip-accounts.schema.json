{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solana sender tip-account registry",
  "type": "object",
  "required": ["accounts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address", "provider", "added"],
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
            "description": "Base58 Solana account that receives the provider's tips"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{2,32}$",
            "description": "Provider slug shown on the sender leaderboard"
          },
          "added": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date the entry was added to this registry (UTC)"
          },
          "signature": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,120}$",
            "description": "Base58 ed25519 signature by the address key over the claim message (see docs/tip-accounts.md)"
          }
        }
      }
    }
  }
}
