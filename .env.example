# Secret/config keys consumed by the monitor. In deployed environments these
# live in Doppler (the source of truth) and are injected via
# `deploy/run-with-doppler.sh`. This file is the local fallback: copy to .env
# and fill in when you don't want to run Doppler locally. Either way, values are
# substituted into the ${...} placeholders in config.yaml provider URLs.

# --- Provider credentials (only those you actually benchmark) ---
HELIUS_API_KEY=
TRITON_HOST=
TRITON_TOKEN=
QUICKNODE_URL=

# --- Logging ---
RUST_LOG=info

# --- Region override (set automatically on GCP; leave blank locally) ---
MONITOR_REGION=

# --- Grafana Cloud remote_write (used by the Alloy agent, not the binary) ---
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_TOKEN=
