{
  "receiver": "empty",
  "group_by": ["grafana_folder", "alertname"],
  "routes": [
    {
      "receiver": "rpc-latency-slack",
      "group_by": ["alertname", "provider", "error_kind"],
      "object_matchers": [["service", "=", "rpc-latency-monitor"]],
      "repeat_interval": "7d"
    }
  ]
}
