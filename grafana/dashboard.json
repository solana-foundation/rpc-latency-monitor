{
  "title": "RPC Latency Monitor",
  "uid": "rpc-latency-monitor",
  "schemaVersion": 39,
  "editable": true,
  "tags": ["solana", "rpc", "latency"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "region",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(rpc_up, region)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(rpc_up{region=~\"$region\"}, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p99 latency by provider / method",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le, provider, method) (rate(rpc_latency_seconds_bucket{region=~\"$region\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "{{provider}} {{method}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50 latency by provider / method",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le, provider, method) (rate(rpc_latency_seconds_bucket{region=~\"$region\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "{{provider}} {{method}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Slot lag by provider",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (provider) (rpc_slot_lag{region=~\"$region\", provider=~\"$provider\"})",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Success rate by provider",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (provider) (rate(rpc_requests_total{status=\"success\", region=~\"$region\", provider=~\"$provider\"}[$__rate_interval])) / sum by (provider) (rate(rpc_requests_total{region=~\"$region\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by provider / status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (provider, status) (rate(rpc_requests_total{region=~\"$region\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Provider up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rpc_up{region=~\"$region\", provider=~\"$provider\"}",
          "legendFormat": "{{provider}}"
        }
      ]
    }
  ]
}
