prometheus.scrape "rpc_latency_monitor" {
  targets = [
    { "__address__" = "127.0.0.1:9464", "job" = "rpc-latency-monitor" },
  ]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  // `host` keeps two boxes that share a region (e.g. a hand-made stand-in
  // beside the terraform one) from writing identical series, which makes
  // rate() see a counter reset on every interleaved sample.
  external_labels = {
    infra = coalesce(sys.env("MONITOR_INFRA"), "gcp"),
    host  = coalesce(sys.env("MONITOR_HOST"), "unknown"),
  }

  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_PROM_TOKEN")
    }
  }

  endpoint {
    url = sys.env("SF_PROM_URL")

    basic_auth {
      username = sys.env("SF_PROM_USER")
      password = sys.env("SF_PROM_TOKEN")
    }
  }
}
